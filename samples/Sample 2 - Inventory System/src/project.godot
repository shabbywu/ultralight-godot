config_version=5

[application]
config/name="Ashen Reliquary"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=1040
window/size/window_width_override=1440
window/size/window_height_override=1040
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="AshenReliquary"

[rendering]
renderer/rendering_method="gl_compatibility"
